  downloadSuspeito Boolean        @default(false) @map("download_suspeito")
  // V3 Plano 12 — origem do download, para o admin medir conversão do
  // follow-gate: "direct" (botão normal) ou "follow_gate" (baixou logo
  // após seguir o artista pelo mini-modal "Seguir para baixar").
