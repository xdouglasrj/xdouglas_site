// V3 Plano 7 — registro idempotente de marcos (milestones) que só podem
// pagar pontos UMA vez por combinação (userId, kind, refId). Streak de
// login diário JÁ EXISTE em User.loginStreak/lastDailyLoginAt + o bônus
// DAILY_LOGIN_STREAK_BONUS a cada 7 dias (lib/points/points-service.ts) —
// não duplicado aqui. Este modelo cobre marcos que aquele mecanismo não
// cobre: plays de faixa (250/1000/10000), 1º comentário da semana,
// 1ª playlist, 1ª curtida dada.
//
// refId é NOT NULL (default '' para marcos sem referência, ex.: 1ª
// playlist) DE PROPÓSITO: Postgres trata NULL como distinto em unique
// constraints, então @@unique com uma coluna nullable NÃO impediria
// múltiplos inserts com refId=NULL — quebraria a idempotência exatamente
// nos marcos "paga 1x na vida" que mais precisam dela.
model MilestoneAward {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "track_plays_250" | "track_plays_1000" | "track_plays_10000" | "first_comment_week" | "first_playlist" | "first_like_given"
  refId     String   @default("") @map("ref_id") // trackId (marco de plays), ISO da semana (comentário semanal) ou "" (sem referência)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, kind, refId])
  @@index([userId])
  @@map("milestone_awards")
}

// V3 Plano 13 — destaque de faixa PAGO com pontos ("Highlight"). Registra
// quem pagou, quanto, e a janela de exibição. O débito de pontos
// (PointsHistory action HIGHLIGHT_TRACK) e a criação deste registro
// acontecem na MESMA transação (lib/store/highlight-service.ts), reusando
// a checagem de saldo transacional da loja — nunca debita sem destacar nem
// destaca sem debitar. Diferente do destaque editorial do admin
// (Track.pinned), que continua tendo prioridade e não custa pontos.
// A vitrine filtra por endsAt > now (sem cron); cleanup só faz manutenção.
model TrackHighlight {
  id         String   @id @default(uuid())
  trackId    String   @map("track_id")
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") // quem pagou (dono da faixa)
  user       User     @relation(fields: [userId], references: [id])
  costPoints Int      @map("cost_points")
  startsAt   DateTime @default(now()) @map("starts_at")
  endsAt     DateTime @map("ends_at")
  // Cancelamento pelo admin (moderação) com estorno de pontos. Quando
  // cancelado, endsAt é encurtado para "agora" e canceledAt é preenchido —
  // some da vitrine na hora e não pode ser reaberto.
  canceledAt DateTime? @map("canceled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([trackId])
  @@index([endsAt])
  @@map("track_highlights")
}

