  completedAt      DateTime?      @map("completed_at")

  @@index([trackId])
  @@index([downloadSuspeito])
  @@index([createdAt])
  @@index([status])
  @@index([trackId, downloadSuspeito, createdAt])
  @@map("downloads")
}

