// =============================================================
// xDouglas — Schema Prisma
// =============================================================
// Fase 1 (nova arquitetura): Genre, Playlist, PlaylistTrack,
// ForumSector, Notification, Role.MODERATOR, campos de
// privacidade no User, featureFlags no AppSettings.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum Role {
  GUEST
  MEMBER
  ARTIST
  ARTIST_SUPPORTER
  MODERATOR
  ADMIN
}

// Plano de armazenamento do usuário — define a cota de espaço usada nos
// uploads de música (ver lib/settings/plan-quotas.ts pelos valores em MB)
enum UserPlan {
  FREE
  PAID
}

enum DownloadStatus {
  INICIADO
  CONCLUIDO
  EXPIRADO
}

enum WaitlistTipoUsuario {
  DJ
  PRODUTOR
  ARTISTA
  MUSICO
  OUVINTE
  OUTRO
}

// =============================================================
// GAMIFICAÇÃO — enums
// =============================================================

// Toda ação que gera (ou remove) pontos passa por aqui — histórico
// completo em PointsHistory, nunca alteração direta de saldo.
enum PointActionType {
  USER_REGISTERED
  PROFILE_COMPLETED
  AVATAR_ADDED
  FIRST_LOGIN
  DAILY_LOGIN
  DAILY_LOGIN_STREAK_BONUS
  TRACK_LIKED
  COMMENT_CREATED
  TRACK_SHARED
  REPOST_RECEIVED
  TRACK_PUBLISHED
  TRACK_PLAYED
  PLAYLIST_CREATED
  FRIEND_INVITE_COMPLETED
  TRACK_MILESTONE_1000
  STORE_REDEMPTION
  INVITE_ABUSE_PENALTY
  ADMIN_GIFT
  ADMIN_ADJUSTMENT
  // V3 Plano 7 — marcos de plays do artista (250 e 10.000; o de 1.000 já
  // existia) e tarefas "Ganhe pontos" (onboarding + engajamento semanal)
  TRACK_MILESTONE_250
  TRACK_MILESTONE_10000
  FIRST_COMMENT_OF_WEEK
  FIRST_PLAYLIST_CREATED
  FIRST_LIKE_GIVEN
  // V3 Plano 13 — débito ao destacar a própria faixa gastando pontos
  // ("Highlight"). Valor vem do custo em lib/points/constants.ts na hora.
  HIGHLIGHT_TRACK
  // V3 Plano 9 — recompensa por completar 100% do perfil (foto, capa, bio,
  // link social, 1ª curtida, 1ª playlist, seguir 3). Idempotente via
  // MilestoneAward (kind "profile_100_percent") — awardMilestoneOnce.
  PROFILE_100_PERCENT
}

// Pra quem o item da loja está disponível — Artista (role ARTIST) ou
// Ouvinte (demais roles não-admin), ou os dois.
enum StoreAudience {
  ARTIST
  LISTENER
  BOTH
}

enum StoreItemKey {
  PRIORITY_INVITE
  PIN_TRACK_COMMENT
  FEATURE_TRACK
  EXTRA_STORAGE
  MAPPING_ACCESS
  APP_PREMIUM
  PIN_FEED_POST
}

// Ciclo de vida de uma compra na loja — itens "de uso" (fixar
// comentário/destaque) passam por AWAITING_USE -> ACTIVE -> USED/EXPIRED;
// itens "de efeito imediato" (armazenamento, convite) vão direto pra USED.
enum StorePurchaseStatus {
  AWAITING_USE
  ACTIVE
  USED
  EXPIRED
  REFUNDED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  TRACK_CREATE
  TRACK_UPDATE
  TRACK_DELETE
  ARTIST_CREATE
  ARTIST_UPDATE
  ARTIST_DELETE
  ADMIN_ACCESS
  SUSPICIOUS_DOWNLOAD_FLAGGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PERMISSIONS_UPDATE
}

enum EventType {
  PAGE_VIEW
  MUSIC_VIEW
  DOWNLOAD_START
  DOWNLOAD_COMPLETE
  DOWNLOAD_FAILED
  WAITLIST_JOIN
  CONSENT_GIVEN
  CONSENT_REVOKED
  PLAY_START
  PLAY_30S
  PLAY_COMPLETE
}

enum ReportTargetType {
  POST
  COMMENT
  FORUM_THREAD
  FORUM_REPLY
  TRACK
  USER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum SupportTicketStatus {
  PENDING
  RESOLVED
}

enum SupportCategory {
  BUG
  SUGESTAO
  DUVIDA
  OUTRO
}

enum SupportAttachmentType {
  IMAGE
  VIDEO
}

// =============================================================
// USERS — base de todos os papéis
// =============================================================

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  // Identificador de LOGIN — privado, nunca exibido publicamente nem usado
  // em rotas/links de perfil (ver "handle" abaixo para o @ público)
  username               String?   @unique @map("username")
  password               String
  name                   String?
  // @ público da comunidade — usado em /perfil/<handle> e nas menções no
  // fórum/feed. Separado do username de login por segurança.
  handle                 String?   @unique @map("handle")
  role                   Role      @default(GUEST)
  // Permissões granulares de moderador (só usadas quando role == MODERATOR)
  permissions            String[]  @default([]) @map("permissions")
  // Cota de armazenamento de upload — ver lib/settings/plan-quotas.ts
  plan                   UserPlan  @default(FREE)
  active                 Boolean   @default(true)
  inviteCode             String?   @map("invite_code")
  phone                  String?
  artisticName           String?   @map("artistic_name")
  newsletterOptIn        Boolean   @default(false) @map("newsletter_opt_in")
  lastLoginAt            DateTime? @map("last_login_at")
  blocked                Boolean   @default(false)
  blockedAt              DateTime? @map("blocked_at")
  photoKey               String?   @map("photo_key")
  photoUrl               String?   @map("photo_url")

  // V3 Plano 9 — completude de perfil: bio, capa e links sociais (avatar já
  // existe via photoKey/photoUrl acima, não duplicado aqui)
  bio                    String?
  coverKey               String?   @map("cover_key")
  coverUrl               String?   @map("cover_url")
  instagramUrl           String?   @map("instagram_url")
  youtubeUrl             String?   @map("youtube_url")
  tiktokUrl              String?   @map("tiktok_url")
  websiteUrl             String?   @map("website_url")
  // Lembrete "complete seu perfil" — enviado no máx. 1x (perfil <50% após 3 dias)
  profileReminderSentAt  DateTime? @map("profile_reminder_sent_at")

  // Privacidade — campos originais
  showEmail              Boolean   @default(false) @map("show_email")
  showPhone              Boolean   @default(false) @map("show_phone")
  showName               Boolean   @default(true)  @map("show_name")

  // Privacidade — campos novos (Fase 1)
  showMusicasNoPerfil      Boolean @default(true)  @map("show_musicas_perfil")
  showEspacoUploadNoPerfil Boolean @default(true)  @map("show_upload_space_perfil")
  showContatosNoPerfil     Boolean @default(false) @map("show_contatos_perfil")
  allowComentariosNaMusica Boolean @default(true)  @map("allow_comentarios_musica")
  showComentariosVisiveis  Boolean @default(true)  @map("show_comentarios_visiveis")

  mappingEnabled         Boolean   @default(false) @map("mapping_enabled")

  // V3 Plano 19 — preferências de notificação (por categoria, JSON simples
  // evita 1 coluna por tipo — ver lib/notifications/notification-prefs.ts)
  // e tema (persistido pro logado sincronizar entre dispositivos; anônimo
  // continua controlando só via localStorage, ver components/ui/theme-toggle.tsx)
  notificationPrefs      Json?     @map("notification_prefs")
  theme                  String    @default("dark") @map("theme")

  resetPasswordTokenHash String?   @unique @map("reset_password_token_hash")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")
  resetPasswordUsedAt    DateTime? @map("reset_password_used_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Gamificação
  totalXp               Int       @default(0) @map("total_xp")
  level                 Int       @default(1)
  loginStreak           Int       @default(0) @map("login_streak")
  lastDailyLoginAt      DateTime? @map("last_daily_login_at")
  priorityInviteCredits Int       @default(0) @map("priority_invite_credits")
  bonusStorageMb        Int       @default(0) @map("bonus_storage_mb")
  mappingExpiresAt      DateTime? @map("mapping_expires_at")
  appPremiumExpiresAt   DateTime? @map("app_premium_expires_at")
  inviteAbuseLevel      Int       @default(0) @map("invite_abuse_level")
  inviteBlockedUntil    DateTime? @map("invite_blocked_until")

  pointsHistory           PointsHistory[]
  milestoneAwards         MilestoneAward[]
  storePurchases          StorePurchase[]
  trackHighlights         TrackHighlight[]
  paymentOrders           PaymentOrder[]
  referredWaitlistEntries Waitlist[]      @relation("WaitlistReferrals")
  // V3 Plano 6 — submissões enviadas pelo usuário a concursos
  contestEntries          ContestEntry[]

  adminSessions   AdminSession[]
  auditLogs       AuditLog[]
  artist          Artist?
  submittedTracks Track[]        @relation("TrackSubmittedBy")

  // Social
  following      Follow[]        @relation("Follower")
  followers      Follow[]        @relation("Following")
  posts          Post[]
  likes          Like[]
  trackLikes     TrackLike[]
  comments       Comment[]
  trackComments  TrackComment[]
  trackCommentLikes TrackCommentLike[]
  trackReposts   TrackRepost[]
  trackReactions TrackReaction[]
  playbackProgress PlaybackProgress[]
  listeningHistory ListeningHistory[]
  forumThreads   ForumThread[]
  forumReplies   ForumReply[]
  reportsMade    Report[]        @relation("ReportsMade")
  supportTickets SupportTicket[]

  // Novos (Fase 1)
  playlists      Playlist[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// =============================================================
// SOCIAL — seguir
// =============================================================

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId String   @map("following_id")
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// =============================================================
// SOCIAL — feed (posts, curtidas, comentários)
// =============================================================

model Post {
  id              String    @id @default(uuid())
  authorId        String    @map("author_id")
  author          User      @relation(fields: [authorId], references: [id])
  content         String
  createdAt       DateTime  @default(now()) @map("created_at")
  pinned          Boolean   @default(false)
  pinnedAt        DateTime? @map("pinned_at")
  pinnedExpiresAt DateTime? @map("pinned_expires_at")

  likes    Like[]
  comments Comment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([pinned])
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String    @id @default(uuid())
  postId    String    @map("post_id")
  post      Post      @relation(fields: [postId], references: [id])
  authorId  String    @map("author_id")
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  pinned    Boolean   @default(false)
  pinnedAt  DateTime? @map("pinned_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@index([pinned])
  @@map("comments")
}

// =============================================================
// FÓRUM — setores, tópicos e respostas
// =============================================================

model ForumSector {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  order         Int      @default(0)
  onlyAdminPost Boolean  @default(false) @map("only_admin_post")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  threads ForumThread[]

  @@index([active])
  @@index([order])
  @@map("forum_sectors")
}

model ForumThread {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  // Setor ao qual o tópico pertence (nullable para compatibilidade com
  // tópicos criados antes da setorização)
  sectorId  String?      @map("sector_id")
  sector    ForumSector? @relation(fields: [sectorId], references: [id])

  replies ForumReply[]

  @@index([authorId])
  @@index([createdAt])
  @@index([sectorId])
  @@map("forum_threads")
}

model ForumReply {
  id        String      @id @default(uuid())
  threadId  String      @map("thread_id")
  thread    ForumThread @relation(fields: [threadId], references: [id])
  authorId  String      @map("author_id")
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([threadId])
  @@map("forum_replies")
}

// =============================================================
// DENÚNCIAS — moderação de conteúdo
// =============================================================

model Report {
  id         String           @id @default(uuid())
  reporterId String           @map("reporter_id")
  reporter   User             @relation("ReportsMade", fields: [reporterId], references: [id])
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id")
  reason     String
  status     ReportStatus     @default(PENDING)
  resolvedAt DateTime?        @map("resolved_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("reports")
}

// =============================================================
// SUPORTE — chamados abertos pelos membros
// =============================================================

model SupportTicket {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  user           User                   @relation(fields: [userId], references: [id])
  category       SupportCategory        @default(OUTRO)
  message        String
  attachmentKey  String?                @map("attachment_key")
  attachmentUrl  String?                @map("attachment_url")
  attachmentType SupportAttachmentType? @map("attachment_type")
  status         SupportTicketStatus    @default(PENDING)
  resolvedAt     DateTime?              @map("resolved_at")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

// =============================================================
// ARTISTS
// =============================================================

model Artist {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  bio       String?
  photoKey  String?  @map("photo_key")
  photoUrl  String?  @map("photo_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  schedulingToken String? @unique @map("scheduling_token")

  tracks Track[]
  series TrackSeries[]
  events ArtistEvent[]
  // V3 Plano 6 — concursos hospedados por este artista (opcional; só o
  // admin cria contests nesta v1, mas pode atribuir um artista host)
  hostedContests Contest[]

  @@index([slug])
  @@index([active])
  @@map("artists")
}

// =============================================================
// EVENTOS — agenda de apresentações do artista (V3 Plano 18)
// v1 enxuta: SEM venda de ingresso, SEM RSVP — vitrine "onde o
// xdouglas vai tocar". infoUrl é opcional (link de ingressos/infos
// externo), validado http/https no servidor antes de salvar.
// =============================================================

model ArtistEvent {
  id        String   @id @default(uuid())
  slug      String   @unique
  artistId  String   @map("artist_id")
  artist    Artist   @relation(fields: [artistId], references: [id])
  title     String
  venue     String?
  city      String?
  startsAt  DateTime @map("starts_at")
  infoUrl   String?  @map("info_url")
  coverKey  String?  @map("cover_key")
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([artistId, startsAt])
  @@map("artist_events")
}

// =============================================================
// CONTESTS — concursos de remix (V3 Plano 6). Prêmio em pontos da loja
// (nunca dinheiro/cripto) + destaque de 7 dias na faixa vencedora. Só o
// admin cria contests nesta v1 (artistas pedem via suporte). Submissão =
// uma faixa do fluxo de upload normal vinculada ao contest via contestId.
// =============================================================

model Contest {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  description  String // regras em markdown/texto
  coverKey     String?   @map("cover_key")
  stemsKey     String?   @map("stems_key") // zip no mesmo storage dos áudios
  hostArtistId String?   @map("host_artist_id")
  hostArtist   Artist?   @relation(fields: [hostArtistId], references: [id])
  prizePoints  Int       @default(0) @map("prize_points")
  prizeText    String?   @map("prize_text") // prêmios extras descritos livres
  deadline     DateTime
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  entries      ContestEntry[]

  @@index([published])
  @@index([deadline])
  @@map("contests")
}

// Uma submissão = uma faixa (do fluxo de upload normal) vinculada a um
// contest. @@unique([contestId, userId]) trava 1 entry por usuário nesta
// v1. trackId é @unique porque cada faixa só pode ser a submissão de UM
// contest (não faz sentido a mesma faixa competir em dois concursos).
// `winner` também é a trava de idempotência do crédito de prêmio — ver
// lib/contests/winners.ts: só credita ADMIN_GIFT quando winner passa de
// false para true dentro da mesma transação que grava esse campo.
model ContestEntry {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  trackId   String   @unique @map("track_id")
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  winner    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@map("contest_entries")
}

// =============================================================
// GÊNEROS MUSICAIS — hierárquico (categoria-mãe + subgêneros)
// =============================================================

model Genre {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  parentId  String?  @map("parent_id")
  parent    Genre?   @relation("GenreHierarchy", fields: [parentId], references: [id])
  children  Genre[]  @relation("GenreHierarchy")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tracks Track[]

  @@index([parentId])
  @@index([active])
  @@index([order])
  @@map("genres")
}

// =============================================================
// TRACKS (músicas)
// =============================================================

model Track {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  description String?
  // genre (String) mantido durante a transição — será removido após migração
  // de dados existentes para genreId
  genre       String?
  // genreId é a FK nova para o catálogo hierárquico de gêneros
  genreId     String? @map("genre_id")
  genreRef    Genre?  @relation(fields: [genreId], references: [id])
  bpm         Int?
  key         String?
  // V3 Plano 5 — metadados DJ: mood (lista fixa em lib/tracks/moods.ts),
  // tags livres (máx. 10, lowercase) e duração extraída no upload
  mood            String?
  tags            String[] @default([])
  durationSeconds Int?     @map("duration_seconds")
  // V3 Plano 16 — tipo de upload: "track" | "set" | "podcast" (lista fixa em
  // lib/tracks/track-kinds.ts). Default "track" preserva faixas existentes.
  kind            String   @default("track") @map("kind")

  artistId     String  @map("artist_id")
  artist       Artist  @relation(fields: [artistId], references: [id])
  producerName String? @map("producer_name")

  submittedById String? @map("submitted_by_id")
  submittedBy   User?   @relation("TrackSubmittedBy", fields: [submittedById], references: [id])

  audioKey       String  @map("audio_key")
  audioFormat    String  @map("audio_format")
  audioSizeBytes BigInt? @map("audio_size_bytes")
  coverKey       String? @map("cover_key")
  coverUrl       String? @map("cover_url")

  downloadAudioKey        String? @map("download_audio_key")
  downloadAudioVinhetaKey String? @map("download_audio_vinheta_key")

  // V3 Plano 12 — modo de download: "free" (qualquer conta baixa) ou
  // "follow" (exige seguir o dono da faixa). Default "free" preserva o
  // comportamento atual de todas as faixas existentes.
  downloadMode String @default("free") @map("download_mode") // "free" | "follow"

  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  downloadCount Int       @default(0) @map("download_count")
  pinned        Boolean   @default(false)
  pinnedAt      DateTime? @map("pinned_at")
  featuredUntil DateTime? @map("featured_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  scheduledAt   DateTime? @map("scheduled_at")

  // V3 Plano 20 — verificação de copyright via AcoustID (best-effort,
  // nunca bloqueia upload/publicação). "pending" | "clear" | "match" |
  // "error" | "skipped". copyrightResult só é preenchido quando "match":
  // { score, recordingId, title, artist }
  copyrightStatus String    @default("pending") @map("copyright_status")
  copyrightResult Json?     @map("copyright_result")
  copyrightAt     DateTime? @map("copyright_at")

  // V3 Plano 14 — série de sets (volumes/episódios). Opcional: faixa sem
  // série não muda em nada. episodeNumber é sugerido (maior da série + 1)
  // mas editável no formulário.
  seriesId      String?      @map("series_id")
  series        TrackSeries? @relation(fields: [seriesId], references: [id])
  episodeNumber Int?         @map("episode_number")

  downloads     Download[]
  likes         TrackLike[]
  comments      TrackComment[]
  playlistTracks PlaylistTrack[]
  reposts       TrackRepost[]
  reactions     TrackReaction[]
  playbackProgress PlaybackProgress[]
  listeningHistory ListeningHistory[]
  tracklist        TrackTracklistItem[]
  highlights       TrackHighlight[]
  // V3 Plano 6 — participação em concurso (1:1: uma faixa só pode ser
  // a submissão de UM contest, ver @@unique em ContestEntry)
  contestEntry     ContestEntry?

  @@index([slug])
  @@index([artistId])
  @@index([published])
  @@index([genre])
  @@index([genreId])
  @@index([submittedById])
  @@index([pinned])
  @@index([scheduledAt])
  @@index([mood])
  @@index([kind])
  @@index([seriesId])
  @@map("tracks")
}

// V3 Plano 14 — série de sets/podcasts recorrentes ("Sunday Soul Sessions").
// Página própria pública (/series/[slug]) e navegação entre episódios na
// página da faixa. `Playlist` existente é biblioteca pessoal do usuário
// (não vitrine pública do artista) — por isso um modelo novo, e não reuso.
model TrackSeries {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  coverKey    String?  @map("cover_key")
  artistId    String   @map("artist_id")
  artist      Artist   @relation(fields: [artistId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tracks Track[]

  @@unique([artistId, title])
  @@index([artistId])
  @@map("track_series")
}

// V3 Plano 10 — tracklist com timestamps do set (uma linha por música).
// Digitada no upload; clicar numa linha faz seek no player global. Cada
// linha é texto indexável (SEO: nomes de música dentro do mix no Google).
model TrackTracklistItem {
  id           String @id @default(uuid())
  trackId      String @map("track_id")
  track        Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position     Int // ordem 1..n
  startSeconds Int    @map("start_seconds")
  title        String // "Artista - Nome da música"

  @@unique([trackId, position])
  @@index([trackId])
  @@map("track_tracklist_items")
}

model TrackComment {
  id              String    @id @default(uuid())
  trackId         String    @map("track_id")
  track           Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  authorId        String    @map("author_id")
  author          User      @relation(fields: [authorId], references: [id])
  content         String
  editedAt        DateTime? @map("edited_at")
  pinned          Boolean   @default(false)
  pinnedAt        DateTime? @map("pinned_at")
  pinnedExpiresAt DateTime? @map("pinned_expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // V3 Plano 2 — respostas aninhadas (1 nível), timestamp da música e likes
  parentId         String?            @map("parent_id")
  parent           TrackComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          TrackComment[]     @relation("CommentReplies")
  timestampSeconds Int?               @map("timestamp_seconds")
  likes            TrackCommentLike[]

  @@index([trackId])
  @@index([pinned])
  @@index([parentId])
  @@map("track_comments")
}

model TrackCommentLike {
  id        String       @id @default(uuid())
  commentId String       @map("comment_id")
  comment   TrackComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("track_comment_likes")
}

model TrackLike {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([trackId, userId])
  @@index([trackId])
  @@index([userId])
  @@map("track_likes")
}

// V3 Plano 3 — repostar música no perfil (estilo Audius)
model TrackRepost {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([trackId, userId])
  @@index([userId])
  @@map("track_reposts")
}

// V3 Plano 15 — reações com emoji (camada expressiva ADICIONAL ao TrackLike;
// não vale ponto, não influencia trending). Conjunto fixo em lib/reactions.ts.
// 1 reação por usuário por faixa — trocar de emoji substitui a anterior.
model TrackReaction {
  id        String   @id @default(uuid())
  trackId   String   @map("track_id")
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([trackId, userId])
  @@index([trackId])
  @@index([userId])
  @@map("track_reactions")
}

// V3 Plano 11 — retomar de onde parou (resume playback), só para logados.
// Anônimo usa localStorage no client, nunca chega aqui.
model PlaybackProgress {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  trackId         String   @map("track_id")
  track           Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  positionSeconds Int      @map("position_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([updatedAt])
  @@map("playback_progress")
}

// V3 Plano 17 — histórico de escuta (privado, só o dono vê).
// Deriva DE PlaybackProgress foi avaliado e descartado: PlaybackProgress só
// existe para faixas >= 10min (MIN_DURATION_FOR_RESUME_SECONDS) e é APAGADA
// quando a faixa é concluída (>=95%) — a maioria das músicas do site é mais
// curta que 10min e nunca geraria uma linha lá, então o histórico ficaria
// vazio para o caso comum. ListeningHistory registra qualquer faixa ouvida
// por >=10s, logado, independente de duração.
model ListeningHistory {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id])
  trackId  String   @map("track_id")
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now()) @map("played_at")

  // Guarda só a ÚLTIMA escuta de cada faixa (upsert) — reouvir sobe pro topo
  @@unique([userId, trackId])
  @@index([userId, playedAt])
  @@map("listening_history")
}

